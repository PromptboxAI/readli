# Copy to .env.local (or run `vercel env pull`). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by API routes; never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=
# Optional. Defaults to eleven_v4 (newest). Set eleven_multilingual_v2 to go back.
ELEVENLABS_MODEL_ID=
# Long random string (e.g. `openssl rand -base64 48`). Signs guest cookies and encrypts provider voice ids.
GUEST_COOKIE_SECRET=
# Long random string. Vercel Cron sends it to /api/cron/guest-cleanup.
CRON_SECRET=
# Set to false to switch voice previews off everywhere (global kill switch).
DEMO_AUDIO_ENABLED=
# Local dev without keys: VOICE_PROVIDER=stub uses in-memory storage and a stand-in tone, labelled as not your voice.
VOICE_PROVIDER=
# Comma-separated emails allowed into /admin. Defaults to admin@readli.ai and kevin@promptbox.com.
ADMIN_EMAILS=
# Payments (Stripe). Off unless PAYMENTS_ENABLED=true. Use test keys (sk_test_…); a live key is refused unless PAYMENTS_LIVE=true.
PAYMENTS_ENABLED=
PAYMENTS_LIVE=
STRIPE_SECRET_KEY=
# From the Stripe dashboard (or `stripe listen`) for the /api/billing/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional. Ownership codes from Google Search Console and Bing Webmaster Tools (the content of their meta tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
